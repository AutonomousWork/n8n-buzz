{
	"name": "n8n-nodes-buzz",
	"version": "0.1.1",
	"description": "Send signed messages from self-hosted n8n workflows to Buzz channels",
	"license": "MIT",
	"homepage": "https://github.com/AutonomousWork/n8n-buzz#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-node",
		"buzz",
		"nostr",
		"notifications",
		"automation",
		"agents"
	],
	"author": {
		"name": "Autonomous Work",
		"email": "projects@autonomouswork.com",
		"url": "https://www.autonomouswork.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AutonomousWork/n8n-buzz.git"
	},
	"bugs": {
		"url": "https://github.com/AutonomousWork/n8n-buzz/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build && esbuild nodes/Buzz/GenericFunctions.ts --bundle --platform=node --target=node22 --format=cjs --legal-comments=inline --outfile=dist/nodes/Buzz/GenericFunctions.js",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --import tsx --test test/**/*.test.ts",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/BuzzApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Buzz/Buzz.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.41.2",
		"esbuild": "^0.25.10",
		"eslint": "9.39.4",
		"nostr-tools": "^2.16.2",
		"prettier": "3.8.3",
		"release-it": "20.2.1",
		"tsx": "^4.20.6",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22"
	}
}
